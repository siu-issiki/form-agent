{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/apply-migrations.ts",
    "test/browser-use-smoke.test.ts",
    "test/worker.test.ts"
  ]
}
