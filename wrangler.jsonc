{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "form-agent",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "FormAgentSandbox",
      "image": "./Dockerfile"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "FormAgentSandbox",
        "name": "SANDBOX"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["FormAgentSandbox"],
      "tag": "v1"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "form-agent-local",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOB_QUEUE",
        "queue": "form-agent-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "form-agent-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "form-agent-jobs-dlq",
        "max_concurrency": 5
      },
      {
        "queue": "form-agent-jobs-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}
