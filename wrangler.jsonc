{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "form-agent",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"AGENT_EXECUTOR_ENABLED": "true",
		"AGENT_MODEL": "gpt-5.6-luna",
		"AGENT_DRY_RUN": "false"
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["FormAgentSandbox"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["FormAgentSandbox"]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "form-agent",
			"database_id": "a48d393a-c9ac-452a-84be-e722a6f8e15b",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "EVIDENCE_BUCKET",
			"bucket_name": "form-agent-evidence"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "JOB_QUEUE",
				"queue": "form-agent-jobs"
			}
		],
		"consumers": [
			{
				"queue": "form-agent-jobs",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"dead_letter_queue": "form-agent-jobs-dlq",
				"max_concurrency": 5
			},
			{
				"queue": "form-agent-jobs-dlq",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 3
			}
		]
	}
}
