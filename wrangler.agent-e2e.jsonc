{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "form-agent-e2e",
  "main": "test/e2e-worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "form-agent-e2e",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE_BUCKET",
      "bucket_name": "form-agent-evidence-e2e"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOB_QUEUE",
        "queue": "form-agent-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "form-agent-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 0,
        "dead_letter_queue": "form-agent-jobs-dlq",
        "max_concurrency": 1
      },
      {
        "queue": "form-agent-jobs-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 0
      }
    ]
  }
}
