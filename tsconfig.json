{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"]
	},
	"include": [
		"src/job.ts",
		"src/agent-runtime.ts",
		"src/agent-executor.ts",
		"src/browser-use-client.ts",
		"src/browser-use-cdp-submission-policy.ts",
		"src/restricted-browser.ts",
		"src/observed-form.ts",
		"src/campaign-import.ts",
		"src/real-send-guard.ts",
		"src/agent-tool-schema.ts",
		"test/campaign-choice-profile.test.ts",
		"test/job.test.ts",
		"test/agent-executor.test.ts",
		"test/browser-use-client.test.ts",
		"test/browser-use-cdp-submission-policy.test.ts",
		"test/restricted-browser.test.ts",
		"test/observed-form.test.ts",
		"test/campaign-import.test.ts",
		"test/real-send-guard.test.ts",
		"test/agent-tool-schema.test.ts",
		"test/helpers/*.ts",
		"tools/browser-use-sessions.ts",
		"tools/campaign-dry-run.ts",
		"tools/campaign-send.ts",
		"tools/test-system-dry-run.ts",
		"vitest.config.ts",
		"vitest.browser-use.config.ts",
		"test/run-agent-e2e.ts"
	]
}
